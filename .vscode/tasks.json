{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-Wall",
                "-Iinclude",
                "-Iinclude/trees",
                "-Iinclude/utils",
                "src/*.c",
                "src/trees/*.c",
                "-o",
                "${workspaceFolder}/program.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Compila todos os arquivos fonte do projeto C"
        }
    ]
}